{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin-page" },
    { "source": "/admin/login", "destination": "/admin-login.html" }
  ],
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/admin", "/admin.html", "/admin.js", "/api/admin/:path*"]
  },
  "functions": {
    "api/admin-page.js": { "includeFiles": "api/_private/admin.html" },
    "api/admin-assets.js": { "includeFiles": "api/_private/admin.js" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' https: data:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
